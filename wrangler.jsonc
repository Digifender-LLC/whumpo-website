{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whumpo-platform",
  "account_id": "f94d28e88a63fb6f34c3ecbc05aa3faf",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "whumpo.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "test",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFIoE2toIv5N36J5",
    "AI_BASE_URL": "https://opencode.ai/zen/go/v1",
    "AI_MODEL": "muse-spark-1.3-contributor",
    "AI_PROTOCOL": "responses"
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1001002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whumpo-control-protection-test",
      "database_id": "15f87c0c-8c4f-491f-a349-ff9c2c8a62b8"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "whumpo-files"
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *",
      "47 * * * *"
    ]
  },
  "services": [
    {
      "binding": "BACKEND_RUNTIME",
      "service": "whumpo-runtime"
    }
  ]
}
