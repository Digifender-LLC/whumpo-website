{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whumpo-sites",
  "account_id": "f94d28e88a63fb6f34c3ecbc05aa3faf",
  "main": "src/site-host.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "*.whumpo.site/*",
      "zone_name": "whumpo.site"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whumpo-control-2026-11-01",
      "database_id": "8980d28a-8c97-4246-b136-1475cc844e58"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "whumpo-files"
    }
  ],
  "services": [
    {
      "binding": "BACKEND_RUNTIME",
      "service": "whumpo-runtime"
    },
    {
      "binding": "APP_HOST",
      "service": "whumpo-apps"
    }
  ],
  "ratelimits": [
    {
      "name": "SITE_LIMITER",
      "namespace_id": "1001005",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
