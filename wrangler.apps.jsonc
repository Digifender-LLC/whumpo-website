{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tellumo-apps",
  "account_id": "f94d28e88a63fb6f34c3ecbc05aa3faf",
  "main": "src/app-host.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "ENVIRONMENT": "test"
  },
  "assets": {
    "directory": "./public-app",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whumpo-control-memory-test",
      "database_id": "4e4c7449-d80a-49d1-bc67-b86034708f13"
    }
  ],
  "services": [
    {
      "binding": "BACKEND_RUNTIME",
      "service": "tellumo-runtime"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1001004",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
