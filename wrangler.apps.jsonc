{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whumpo-apps",
  "account_id": "f94d28e88a63fb6f34c3ecbc05aa3faf",
  "main": "src/app-host.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "ENVIRONMENT": "test",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFIoE2toIv5N36J5"
  },
  "assets": {
    "directory": "./public-app",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whumpo-control-2026-10-31d",
      "database_id": "dba36bb8-4d6b-4798-baf3-2572809b2919"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "whumpo-files"
    }
  ],
  "services": [
    {
      "binding": "BACKEND_RUNTIME",
      "service": "whumpo-runtime"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1001004",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
