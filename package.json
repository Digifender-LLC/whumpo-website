{
  "name": "tellumo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/build.mjs && wrangler dev --var ENVIRONMENT:local",
    "db:local": "wrangler d1 migrations apply tellumo-control --local",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test:smoke": "node tests/smoke.mjs",
    "test:ai": "node tests/ai.mjs",
    "deploy": "node tools/deploy.mjs",
    "db:remote": "wrangler d1 migrations apply tellumo-control --remote",
    "invite": "node tools/create-invite.mjs",
    "test:chat": "node tests/chat.mjs",
    "build": "node tools/build.mjs",
    "test:passkeys": "node tests/passkeys.mjs",
    "test:billing": "node tests/billing.mjs",
    "test:runtime-ai": "node tests/runtime-ai.mjs",
    "test:previews": "node tests/previews.mjs",
    "test:publications": "node tests/publications.mjs",
    "deploy:sites": "wrangler deploy --config wrangler.sites.jsonc",
    "dev:sites": "wrangler dev --config wrangler.sites.jsonc --port 8788",
    "test:site-agent": "node tests/site-agent.mjs",
    "test:checkout": "node tests/checkout.mjs",
    "test:exports": "node tests/exports.mjs",
    "test:files": "node tests/files.mjs",
    "test:photo-versions": "node tests/photo-versions.mjs",
    "test:domains": "node tests/domains.mjs",
    "test:onboarding": "node tests/onboarding.mjs",
    "test:workspace-agent": "node tests/workspace-agent.mjs",
    "test:workspace-read": "node tests/workspace-read.mjs",
    "test:github-connection": "node tests/github-connection.mjs",
    "test:github-backups": "node tests/github-backups.mjs",
    "test:domain-agent": "node tests/domain-agent.mjs",
    "test:domain-hosting": "node tests/domain-hosting.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.143.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "fflate": "^0.8.3"
  }
}
